{
  "name": "quran-app",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "build:pages": "BASE=/noor-quran-app/ vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm test && npm run test:e2e",
    "cap:sync": "vite build && npx cap sync",
    "android:aab": "vite build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "android:apk": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lighthouse": "^12.8.2",
    "vite": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "adhan": "^4.4.6",
    "leaflet": "^1.9.4"
  }
}
